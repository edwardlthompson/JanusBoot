{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janusboot.local/schema/settings.schema.json",
  "title": "JanusBoot settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeout", "default", "theme", "features"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "timeout": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999,
      "description": "Seconds before default entry boots. 0 = instant."
    },
    "timeout_style": {
      "type": "string",
      "enum": ["menu", "hidden"]
    },
    "default": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Entry id, or the literal 'saved' for last-used."
    },
    "save_default": {
      "type": "boolean"
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "wallpaper": {
      "type": "string",
      "maxLength": 512,
      "description": "ESP-relative or Limine boot(): path to wallpaper."
    },
    "scan_paths": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "not": { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }
      }
    },
    "hidden": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "last_boot": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "last_boot_ok": {
      "type": "boolean"
    },
    "repair_history": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair", "mouse", "secureboot"],
      "properties": {
        "repair": { "type": "boolean" },
        "mouse": {
          "type": "boolean",
          "description": "Boot UI mouse pointer when loader supports it (off by default)."
        },
        "secureboot": { "type": "boolean" }
      }
    },
    "reduce_motion": {
      "type": "boolean",
      "description": "Skip decorative fades; prefer instant transitions."
    },
    "fast_boot": {
      "type": "boolean",
      "description": "Omit wallpaper/background for faster menu paint."
    },
    "settings_pin": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional gate for boot-UI theme/settings changes (hash only).",
      "properties": {
        "enabled": { "type": "boolean" },
        "salt": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9a-f]+$"
        },
        "hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]+$"
        }
      }
    }
  }
}
