# Generated by janusbootctl — do not edit by hand
# janusboot:last-used=windows-11
# janusboot:mouse=off
# janusboot:reduce-motion=off
# janusboot:fast-boot=off
# See themes/BOOT_UI.md for Limine honest floor vs BURG cards
timeout: 5
default_entry: 1
wallpaper: boot():/EFI/JanusBoot/themes/high-contrast/background.boot.jpg

/Windows 11
    protocol: efi_chainload
    path: boot():/EFI/Microsoft/Boot/bootmgfw.efi
    # janusboot:icon=windows

/Linux Mint
    protocol: efi_chainload
    path: boot():/EFI/ubuntu/shimx64.efi
    # janusboot:icon=linux
